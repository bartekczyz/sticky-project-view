<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>sticky-project-view</id>
    <name>Sticky Project View</name>
    <vendor>hsz</vendor>
    <description><![CDATA[
        <p>Sticky Project View adds sticky parent nodes to the IntelliJ Project View.</p>
        <p>It keeps expanded parent directories pinned at the top while you scroll and preserves the native Project View look:</p>
        <ul>
            <li>expanded parent directories stay pinned at the top while you scroll</li>
            <li>sticky rows keep native Project View rendering, including arrows, icons, colors, and selection</li>
            <li>clicking a sticky row reveals and selects that node in the tree while keeping its parents pinned above it</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>

    <resource-bundle>messages.StickyProjectViewBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="info.chrzanowski.stickyprojectview.ProjectViewStickyTreeDecorator" />
        <applicationConfigurable parentId="tools" id="StickyProjectView.Settings"
                                 instance="info.chrzanowski.stickyprojectview.StickyProjectViewConfigurable"
                                 bundle="messages.StickyProjectViewBundle" key="settings.displayName" />
    </extensions>
    <actions>
        <group id="StickyProjectView.Group" popup="true">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last" />
            <action id="StickyProjectView.Toggle" class="info.chrzanowski.stickyprojectview.ToggleStickyProjectViewAction" />
            <action id="StickyProjectView.Configure" class="info.chrzanowski.stickyprojectview.ConfigureStickyProjectViewAction" />
        </group>
    </actions>
</idea-plugin>
